<Project>
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <Authors>Silvio Martignetti</Authors>
    <Company>Silvio Martignetti</Company>
    <RepositoryUrl>https://github.com/MartiSilvio/Alder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MartiSilvio/Alder</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>alder-icon.png</PackageIcon>
    <Title>Alder</Title>
    <PackageReleaseNotes>Initial 1.0.0 release.</PackageReleaseNotes>
    <Copyright>Copyright © Silvio Martignetti</Copyright>
    <PackageTags>csharp;c-sharp;expressions;expression-evaluator;expression-runtime;expression-parser;scripting;script-engine;rules-engine;dynamic-linq;linq;query;runtime;interpreter;compiler;security-policy;safe-evaluation;nativeaot;aot;source-generator;dotnet</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>
</Project>
