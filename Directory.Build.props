<Project>
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.1</VersionPrefix>
    <Authors>Silvio Martignetti</Authors>
    <Company>Silvio Martignetti</Company>
    <RepositoryUrl>https://github.com/MartiSilvio/Alder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MartiSilvio/Alder</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageIcon>alder-icon.png</PackageIcon>
    <Title>Alder</Title>
    <Copyright>Copyright © Silvio Martignetti</Copyright>
    <PackageTags>csharp expressions expression-evaluator expression-runtime expression-parser scripting script-engine rules-engine dynamic-linq linq query interpreter compiler security-policy nativeaot aot source-generator dotnet</PackageTags>
    <PackageReleaseNotes>Packaging polish: Source Link integration, dedicated NuGet readme, cleaned up package tags.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>
</Project>
