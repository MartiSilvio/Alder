<Project>
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Silvio Martignetti</Authors>
    <Company>Silvio Martignetti</Company>
    <RepositoryUrl>https://github.com/MartiSilvio/Alder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MartiSilvio/Alder</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageIcon>alder-icon.png</PackageIcon>
    <Title>Alder - C# Expression Engine for .NET</Title>
    <Copyright>Copyright © Silvio Martignetti</Copyright>
    <PackageTags>csharp expressions expression-engine expression-evaluator csharp-expression-engine csharp-expression-evaluator dotnet-expression-engine expression-parser formula-engine rules-engine query-engine dynamic-linq linq scripting interpreter compiler security-policy nativeaot aot source-generator dotnet</PackageTags>
    <PackageReleaseNotes>Documentation fix: the NuGet package README now renders as Markdown so the package description displays correctly. No runtime changes since 1.0.4.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
