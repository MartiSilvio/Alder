<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1822;CA1512;CA1513</NoWarn>
    <PackageId>Alder</PackageId>
    <Description>Embeddable C# runtime engine for .NET. Compiler-style parsing and semantic binding, interpreted and compiled execution, Dynamic LINQ, expression-tree export, sandbox policy, and NativeAOT generated dispatch.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddCompiledBackendToPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);AddCompiledBackendSymbolsToPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alder.Generators\Alder.Generators.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\assets\brand\alder-icon.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\Alder.Generators\bin\$(Configuration)\netstandard2.0\Alder.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>

  <Target Name="BuildSinglePackageAssets" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="..\Alder.Generators\Alder.Generators.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
    <MSBuild Projects="..\Alder.Compiled\Alder.Compiled.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0" />
  </Target>

  <Target Name="AddCompiledBackendToPackage" Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildThisFileDirectory)..\Alder.Compiled\bin\$(Configuration)\net8.0\Alder.Compiled.dll">
        <FinalOutputPath>$(MSBuildThisFileDirectory)..\Alder.Compiled\bin\$(Configuration)\net8.0\Alder.Compiled.dll</FinalOutputPath>
        <TargetPath>Alder.Compiled.dll</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>

  <Target Name="AddCompiledBackendSymbolsToPackage" Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="$(MSBuildThisFileDirectory)..\Alder.Compiled\bin\$(Configuration)\net8.0\Alder.Compiled.pdb">
        <FinalOutputPath>$(MSBuildThisFileDirectory)..\Alder.Compiled\bin\$(Configuration)\net8.0\Alder.Compiled.pdb</FinalOutputPath>
        <TargetPath>Alder.Compiled.pdb</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
  
  <ItemGroup>
    <Compile Update="Binding\Binder.Assignments.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Expressions.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Invocations.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Operators.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Statements.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Assignments.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Expressions.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Literals.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Loops.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.MemberAccess.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Statements.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Compilation.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Registration.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.CompiledInvocationState.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Evaluation.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.EvaluationAsync.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.EvaluationState.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.ExpressionState.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Parsing.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Validation.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="AlderEngine.Tracing.cs">
      <DependentUpon>AlderEngine.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
