<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1822;CA1512;CA1513</NoWarn>
    <PackageId>CsEval</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <!-- Bundle the source generator as an analyzer inside this package -->
  <ItemGroup>
    <ProjectReference Include="..\CsEval.Generators\CsEval.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Include the generator DLL in the NuGet package's analyzers folder -->
  <ItemGroup>
    <None Include="..\CsEval.Generators\bin\$(Configuration)\netstandard2.0\CsEval.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Binding\Binder.Assignments.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Expressions.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Invocations.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Operators.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Binding\Binder.Statements.cs">
      <DependentUpon>Binder.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Assignments.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Expressions.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Literals.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Loops.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.MemberAccess.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="Interpretation\BoundEvaluator.Statements.cs">
      <DependentUpon>BoundEvaluator.cs</DependentUpon>
    </Compile>
    <Compile Update="CsEvalEngine.Compilation.cs">
      <DependentUpon>CsEvalEngine.cs</DependentUpon>
    </Compile>
    <Compile Update="CsEvalEngine.Registration.cs">
      <DependentUpon>CsEvalEngine.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
