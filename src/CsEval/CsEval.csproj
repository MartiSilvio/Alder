<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <PackageId>CsEval</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Lightweight C# expression evaluation engine with interpreted and compiled execution modes, optional source-generated dispatch for NativeAOT scenarios, and comprehensive sandboxing.</Description>
  </PropertyGroup>

  <!-- Bundle the source generator as an analyzer inside this package -->
  <ItemGroup>
    <ProjectReference Include="..\CsEval.Generators\CsEval.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Include the generator DLL in the NuGet package's analyzers folder -->
  <ItemGroup>
    <None Include="..\CsEval.Generators\bin\$(Configuration)\netstandard2.0\CsEval.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
